# DeepSeek API 配置 (主进程 .env fallback)
DEEPSEEK_API_KEY=sk-you...here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# 百炼 / 通义千问 API 配置 (渲染进程使用)
AI_API_KEY=sk-you...here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.5-omni-plus

# 阿里云实时语音识别 (NLS)
# NLS_APP_KEY=your-nls-key

# 可选配置
MAX_TOKENS=4096
TEMPERATURE=0.7
AGENT_TIMEOUT_MS=30000
LOG_LEVEL=info
